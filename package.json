{
  "name": "turmoil-activity",
  "version": "1.0.0",
  "main": "server/index.js",
  "scripts": {
    "build": "esbuild client/discord-sdk.js --bundle --format=iife --global-name=OilDiscordSDK --minify --target=es2020 --outfile=dist/discord-sdk.js",
    "start": "npm run build && node --env-file-if-exists=.env server/index.js",
    "dev": "npm run build && node --env-file-if-exists=.env --watch server/index.js",
    "static": "http-server -p 3000 -c-1 -o",
    "test": "node --test test/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Oil digga: ropný tycoon jako Discord Activity",
  "devDependencies": {
    "http-server": "^14.1.1"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/rye": "^5.3.0",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
